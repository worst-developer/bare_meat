{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "declaration": false,
    "types": ["chrome"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.json",
    ".wxt/**/*.{ts,json}"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron"
  ]
}
