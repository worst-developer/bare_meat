//@version=6
indicator("Agent Context - Cross Market", overlay=true, format=format.price, precision=8)

groupGeneral = "01 - General"
groupCross = "02 - Cross Markets"
groupCme = "03 - CME"
groupTechnical = "04 - Local Technical State"
groupStats = "05 - Session Statistics"
groupVisual = "06 - Visual Style"

exportTelemetry = input.bool(true, "Export machine telemetry", group=groupGeneral)
usdtEnabled = input.bool(true, "USDT dominance", inline="usdt", group=groupCross)
usdtTicker = input.symbol("CRYPTOCAP:USDT.D", "", inline="usdt", group=groupCross)
btcEnabled = input.bool(true, "BTC dominance", inline="btc", group=groupCross)
btcTicker = input.symbol("CRYPTOCAP:BTC.D", "", inline="btc", group=groupCross)
ethBtcEnabled = input.bool(true, "ETH / BTC", inline="ethbtc", group=groupCross)
ethBtcTicker = input.symbol("BINANCE:ETHBTC", "", inline="ethbtc", group=groupCross)
dxyEnabled = input.bool(true, "DXY", inline="dxy", group=groupCross)
dxyTicker = input.symbol("TVC:DXY", "", inline="dxy", group=groupCross)
nasdaqEnabled = input.bool(false, "Nasdaq", inline="nasdaq", group=groupCross)
nasdaqTicker = input.symbol("NASDAQ:NDX", "", inline="nasdaq", group=groupCross)
spxEnabled = input.bool(false, "S&P 500", inline="spx", group=groupCross)
spxTicker = input.symbol("SP:SPX", "", inline="spx", group=groupCross)
vixEnabled = input.bool(false, "VIX", inline="vix", group=groupCross)
vixTicker = input.symbol("CBOE:VIX", "", inline="vix", group=groupCross)
us10yEnabled = input.bool(false, "US 10Y", inline="us10y", group=groupCross)
us10yTicker = input.symbol("TVC:US10Y", "", inline="us10y", group=groupCross)
cmeEnabled = input.bool(false, "CME gap telemetry", group=groupCme)
cmeTicker = input.symbol("CME:BTC1!", "CME ticker", group=groupCme)
structureLength = input.int(5, "Swing length", minval=1, group=groupTechnical)
breakConfirmation = input.string("Close", "Break confirmation", options=["Close", "Wick"], group=groupTechnical)
asiaSession = input.session("0900-1500:23456", "Asia", inline="asia", group=groupStats)
asiaTimezone = input.string("Asia/Tokyo", "", inline="asia", group=groupStats)
londonSession = input.session("0800-1200:23456", "London", inline="london", group=groupStats)
londonTimezone = input.string("Europe/London", "", inline="london", group=groupStats)
nySession = input.session("0930-1600:23456", "New York", inline="ny", group=groupStats)
nyTimezone = input.string("America/New_York", "", inline="ny", group=groupStats)
statsLength = input.int(10, "Completed sessions", options=[5, 10, 20], group=groupStats)
showCrossDashboard = input.bool(true, "Show cross-market dashboard", group=groupVisual)

isCurrent = barstate.islast and exportTelemetry
onlyCurrent(value) => isCurrent ? value : na
enabledValue(enabled, value) => enabled ? value : na
boolValue(value) => value ? 1.0 : 0.0
returnPct(value, previous) => not na(previous) and previous != 0 ? (value - previous) / previous * 100.0 : na

pushSample(array<float> samples, float value, int limit) =>
    array.push(samples, value)
    while array.size(samples) > limit
        array.shift(samples)

sampleRate(array<float> samples) => array.size(samples) > 0 ? array.avg(samples) * 100.0 : na
breaksAbove(float level) => not na(level) and (breakConfirmation == "Close" ? close > level and close[1] <= level : high > level and high[1] <= level)
breaksBelow(float level) => not na(level) and (breakConfirmation == "Close" ? close < level and close[1] >= level : low < level and low[1] >= level)
isWeekday(sessionTimezone) =>
    localDay = dayofweek(time, sessionTimezone)
    localDay != dayofweek.saturday and localDay != dayofweek.sunday
sessionActive(sessionValue, sessionTimezone) => isWeekday(sessionTimezone) and not na(time(timeframe.period, sessionValue, sessionTimezone))

marketData(ticker) =>
    marketClose = request.security(ticker, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
    oneHourReturn = request.security(ticker, "60", returnPct(close, close[1]), barmerge.gaps_off, barmerge.lookahead_off)
    fourHourReturn = request.security(ticker, "240", returnPct(close, close[1]), barmerge.gaps_off, barmerge.lookahead_off)
    oneDayReturn = request.security(ticker, "D", returnPct(close, close[1]), barmerge.gaps_off, barmerge.lookahead_off)
    [marketClose, oneHourReturn, fourHourReturn, oneDayReturn]

cmeGapData() =>
    var float fridayClose = na
    var float mondayOpen = na
    var bool gapOpen = false
    if dayofweek == dayofweek.friday
        fridayClose := close
    if dayofweek == dayofweek.monday and dayofweek[1] != dayofweek.monday
        mondayOpen := open
        gapOpen := not na(fridayClose) and mondayOpen != fridayClose
    if gapOpen and not na(fridayClose) and not na(mondayOpen)
        gapFilled = mondayOpen > fridayClose ? low <= fridayClose : high >= fridayClose
        if gapFilled
            gapOpen := false
    [fridayClose, mondayOpen, gapOpen]

[usdtClose, usdt1h, usdt4h, usdt1d] = marketData(usdtTicker)
[btcClose, btc1h, btc4h, btc1d] = marketData(btcTicker)
[ethBtcClose, ethBtc1h, ethBtc4h, ethBtc1d] = marketData(ethBtcTicker)
[dxyClose, dxy1h, dxy4h, dxy1d] = marketData(dxyTicker)
[nasdaqClose, nasdaq1h, nasdaq4h, nasdaq1d] = marketData(nasdaqTicker)
[spxClose, spx1h, spx4h, spx1d] = marketData(spxTicker)
[vixClose, vix1h, vix4h, vix1d] = marketData(vixTicker)
[us10yClose, us10y1h, us10y4h, us10y1d] = marketData(us10yTicker)
[cmeFridayClose, cmeMondayOpen, cmeGapOpen] = request.security(cmeTicker, "D", cmeGapData(), barmerge.gaps_off, barmerge.lookahead_off)

ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)
emaStack = close > ema20 and ema20 > ema50 and ema50 > ema100 and ema100 > ema200 ? 2.0 : close > ema50 and ema20 > ema50 ? 1.0 : close < ema20 and ema20 < ema50 and ema50 < ema100 and ema100 < ema200 ? -2.0 : close < ema50 and ema20 < ema50 ? -1.0 : 0.0
nearestEmaDistance = math.min(math.min(math.abs(close - ema20), math.abs(close - ema50)), math.min(math.abs(close - ema100), math.abs(close - ema200))) / close * 100.0

[pdh, pdl, pdc, pdmid] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1], (high[1] + low[1]) / 2.0], barmerge.gaps_off, barmerge.lookahead_off)
[pwh, pwl, pwc] = request.security(syminfo.tickerid, "W", [high[1], low[1], close[1]], barmerge.gaps_off, barmerge.lookahead_off)
pmc = request.security(syminfo.tickerid, "M", close[1], barmerge.gaps_off, barmerge.lookahead_off)
newDay = timeframe.change("D")
newWeek = timeframe.change("W")
var bool pdhSwept = false
var bool pdlSwept = false
var bool pwhSwept = false
var bool pwlSwept = false
pdhSwept := newDay ? false : pdhSwept or high > pdh
pdlSwept := newDay ? false : pdlSwept or low < pdl
pwhSwept := newWeek ? false : pwhSwept or high > pwh
pwlSwept := newWeek ? false : pwlSwept or low < pwl
pdhState = close > pdh ? 2.0 : pdhSwept ? 3.0 : 0.0
pdlState = close < pdl ? 2.0 : pdlSwept ? 3.0 : 0.0
pwhState = close > pwh ? 2.0 : pwhSwept ? 3.0 : 0.0
pwlState = close < pwl ? 2.0 : pwlSwept ? 3.0 : 0.0

pivotHigh = ta.pivothigh(high, structureLength, structureLength)
pivotLow = ta.pivotlow(low, structureLength, structureLength)
var float lastSwingHigh = na
var float lastSwingLow = na
var bool lastSwingHighBroken = false
var bool lastSwingLowBroken = false
var float protectedHigh = na
var float protectedLow = na
var int trend = 0
var int lastBosBar = na
if not na(pivotHigh)
    lastSwingHigh := pivotHigh
    lastSwingHighBroken := false
if not na(pivotLow)
    lastSwingLow := pivotLow
    lastSwingLowBroken := false
bosEvent = false
if trend == 1
    if breaksBelow(protectedLow)
        trend := -1
        protectedHigh := lastSwingHigh
        lastSwingLowBroken := true
    else if not lastSwingHighBroken and breaksAbove(lastSwingHigh)
        bosEvent := true
        lastSwingHighBroken := true
        protectedLow := lastSwingLow
else if trend == -1
    if breaksAbove(protectedHigh)
        trend := 1
        protectedLow := lastSwingLow
        lastSwingHighBroken := true
    else if not lastSwingLowBroken and breaksBelow(lastSwingLow)
        bosEvent := true
        lastSwingLowBroken := true
        protectedHigh := lastSwingHigh
else if not lastSwingHighBroken and breaksAbove(lastSwingHigh)
    trend := 1
    bosEvent := true
    lastSwingHighBroken := true
    protectedLow := lastSwingLow
else if not lastSwingLowBroken and breaksBelow(lastSwingLow)
    trend := -1
    bosEvent := true
    lastSwingLowBroken := true
    protectedHigh := lastSwingHigh
if bosEvent
    lastBosBar := bar_index
barsSinceBos = na(lastBosBar) ? na : bar_index - lastBosBar

cumPv = ta.cum(hlc3 * volume)
cumVolume = ta.cum(volume)
var float swingHighBasePv = na
var float swingHighBaseVolume = na
var float swingLowBasePv = na
var float swingLowBaseVolume = na
if not na(pivotHigh)
    swingHighBasePv := nz(cumPv[structureLength + 1])
    swingHighBaseVolume := nz(cumVolume[structureLength + 1])
if not na(pivotLow)
    swingLowBasePv := nz(cumPv[structureLength + 1])
    swingLowBaseVolume := nz(cumVolume[structureLength + 1])
swingHighVwap = not na(swingHighBaseVolume) and cumVolume != swingHighBaseVolume ? (cumPv - swingHighBasePv) / (cumVolume - swingHighBaseVolume) : na
swingLowVwap = not na(swingLowBaseVolume) and cumVolume != swingLowBaseVolume ? (cumPv - swingLowBasePv) / (cumVolume - swingLowBaseVolume) : na
dayVwap = ta.vwap(hlc3)
dayVwapDistance = close != 0 ? (dayVwap - close) / close * 100.0 : na

inAsia = sessionActive(asiaSession, asiaTimezone)
inLondon = sessionActive(londonSession, londonTimezone)
inNy = sessionActive(nySession, nyTimezone)
var float asiaHigh = na
var float asiaLow = na
var float previousAsiaHigh = na
var float previousAsiaLow = na
var float londonHigh = na
var float londonLow = na
var float londonClose = na
var float previousLondonHigh = na
var float previousLondonLow = na
var float nyHigh = na
var float nyLow = na
var float nyClose = na
var array<float> asiaHighSweeps = array.new_float()
var array<float> asiaLowSweeps = array.new_float()
var array<float> londonAsiaHighSweeps = array.new_float()
var array<float> londonAsiaLowSweeps = array.new_float()
var array<float> nyLondonReversals = array.new_float()
if inAsia and not inAsia[1]
    asiaHigh := high
    asiaLow := low
else if inAsia
    asiaHigh := math.max(asiaHigh, high)
    asiaLow := math.min(asiaLow, low)
if not inAsia and inAsia[1]
    if not na(previousAsiaHigh)
        pushSample(asiaHighSweeps, asiaHigh > previousAsiaHigh ? 1.0 : 0.0, statsLength)
        pushSample(asiaLowSweeps, asiaLow < previousAsiaLow ? 1.0 : 0.0, statsLength)
    previousAsiaHigh := asiaHigh
    previousAsiaLow := asiaLow
if inLondon and not inLondon[1]
    londonHigh := high
    londonLow := low
    londonClose := close
else if inLondon
    londonHigh := math.max(londonHigh, high)
    londonLow := math.min(londonLow, low)
    londonClose := close
if not inLondon and inLondon[1]
    if not na(previousAsiaHigh)
        pushSample(londonAsiaHighSweeps, londonHigh > previousAsiaHigh ? 1.0 : 0.0, statsLength)
        pushSample(londonAsiaLowSweeps, londonLow < previousAsiaLow ? 1.0 : 0.0, statsLength)
    previousLondonHigh := londonHigh
    previousLondonLow := londonLow
if inNy and not inNy[1]
    nyHigh := high
    nyLow := low
    nyClose := close
else if inNy
    nyHigh := math.max(nyHigh, high)
    nyLow := math.min(nyLow, low)
    nyClose := close
if not inNy and inNy[1] and not na(previousLondonHigh)
    sweptLondonHigh = nyHigh > previousLondonHigh
    sweptLondonLow = nyLow < previousLondonLow
    reversedSweep = (sweptLondonHigh and nyClose < previousLondonHigh) or (sweptLondonLow and nyClose > previousLondonLow)
    if sweptLondonHigh or sweptLondonLow
        pushSample(nyLondonReversals, reversedSweep ? 1.0 : 0.0, statsLength)

telemetryDisplay = display.data_window
plot(onlyCurrent(2), "CTX|META|SCHEMA", display=telemetryDisplay)
plot(onlyCurrent(1), "CTX|META|CURRENT_ONLY", display=telemetryDisplay)
plot(onlyCurrent(time), "CTX|META|BAR_TIME", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(usdtEnabled, usdtClose)), "CTX|CROSS|USDTD|PRICE", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(usdtEnabled, usdt1h)), "CTX|CROSS|USDTD|RET_1H", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(usdtEnabled, usdt4h)), "CTX|CROSS|USDTD|RET_4H", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(usdtEnabled, usdt1d)), "CTX|CROSS|USDTD|RET_1D", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(btcEnabled, btcClose)), "CTX|CROSS|BTCD|PRICE", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(btcEnabled, btc1h)), "CTX|CROSS|BTCD|RET_1H", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(btcEnabled, btc4h)), "CTX|CROSS|BTCD|RET_4H", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(btcEnabled, btc1d)), "CTX|CROSS|BTCD|RET_1D", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(ethBtcEnabled, ethBtcClose)), "CTX|CROSS|ETHBTC|PRICE", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(ethBtcEnabled, ethBtc1h)), "CTX|CROSS|ETHBTC|RET_1H", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(ethBtcEnabled, ethBtc4h)), "CTX|CROSS|ETHBTC|RET_4H", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(ethBtcEnabled, ethBtc1d)), "CTX|CROSS|ETHBTC|RET_1D", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(dxyEnabled, dxyClose)), "CTX|CROSS|DXY|PRICE", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(dxyEnabled, dxy1h)), "CTX|CROSS|DXY|RET_1H", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(dxyEnabled, dxy4h)), "CTX|CROSS|DXY|RET_4H", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(dxyEnabled, dxy1d)), "CTX|CROSS|DXY|RET_1D", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(nasdaqEnabled, nasdaqClose)), "CTX|CROSS|NASDAQ|PRICE", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(nasdaqEnabled, nasdaq1h)), "CTX|CROSS|NASDAQ|RET_1H", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(nasdaqEnabled, nasdaq4h)), "CTX|CROSS|NASDAQ|RET_4H", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(nasdaqEnabled, nasdaq1d)), "CTX|CROSS|NASDAQ|RET_1D", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(spxEnabled, spxClose)), "CTX|CROSS|SPX|PRICE", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(spxEnabled, spx1h)), "CTX|CROSS|SPX|RET_1H", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(spxEnabled, spx4h)), "CTX|CROSS|SPX|RET_4H", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(spxEnabled, spx1d)), "CTX|CROSS|SPX|RET_1D", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(vixEnabled, vixClose)), "CTX|CROSS|VIX|PRICE", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(vixEnabled, vix1h)), "CTX|CROSS|VIX|RET_1H", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(vixEnabled, vix4h)), "CTX|CROSS|VIX|RET_4H", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(vixEnabled, vix1d)), "CTX|CROSS|VIX|RET_1D", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(us10yEnabled, us10yClose)), "CTX|CROSS|US10Y|PRICE", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(us10yEnabled, us10y1h)), "CTX|CROSS|US10Y|RET_1H", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(us10yEnabled, us10y4h)), "CTX|CROSS|US10Y|RET_4H", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(us10yEnabled, us10y1d)), "CTX|CROSS|US10Y|RET_1D", display=telemetryDisplay)
plot(onlyCurrent(ema20), "CTX|EMA|20", display=telemetryDisplay)
plot(onlyCurrent(ema50), "CTX|EMA|50", display=telemetryDisplay)
plot(onlyCurrent(ema100), "CTX|EMA|100", display=telemetryDisplay)
plot(onlyCurrent(ema200), "CTX|EMA|200", display=telemetryDisplay)
plot(onlyCurrent(emaStack), "CTX|EMA|STACK", display=telemetryDisplay)
plot(onlyCurrent(nearestEmaDistance), "CTX|EMA|NEAREST_DIST_PCT", display=telemetryDisplay)
plot(onlyCurrent(pdhState), "CTX|SWEEP|PDH", display=telemetryDisplay)
plot(onlyCurrent(pdlState), "CTX|SWEEP|PDL", display=telemetryDisplay)
plot(onlyCurrent(pwhState), "CTX|SWEEP|PWH", display=telemetryDisplay)
plot(onlyCurrent(pwlState), "CTX|SWEEP|PWL", display=telemetryDisplay)
plot(onlyCurrent(barsSinceBos), "CTX|STRUCT|BARS_SINCE_BOS", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(cmeEnabled, cmeFridayClose)), "CTX|CME|FRI_CLOSE", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(cmeEnabled, cmeMondayOpen)), "CTX|CME|MON_OPEN", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(cmeEnabled, math.max(cmeFridayClose, cmeMondayOpen))), "CTX|CME|GAP_TOP", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(cmeEnabled, math.min(cmeFridayClose, cmeMondayOpen))), "CTX|CME|GAP_BOTTOM", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(cmeEnabled, boolValue(cmeGapOpen))), "CTX|CME|GAP_OPEN", display=telemetryDisplay)
plot(onlyCurrent(pdc), "CTX|LEVEL|PDC", display=telemetryDisplay)
plot(onlyCurrent(pdmid), "CTX|LEVEL|PDMID", display=telemetryDisplay)
plot(onlyCurrent(pwc), "CTX|LEVEL|PWC", display=telemetryDisplay)
plot(onlyCurrent(pmc), "CTX|LEVEL|PMC", display=telemetryDisplay)
plot(onlyCurrent(swingHighVwap), "CTX|VWAP|SWING_HIGH", display=telemetryDisplay)
plot(onlyCurrent(swingLowVwap), "CTX|VWAP|SWING_LOW", display=telemetryDisplay)
plot(onlyCurrent(dayVwapDistance), "CTX|VWAP|DAY|DIST_PCT", display=telemetryDisplay)
plot(onlyCurrent(sampleRate(asiaHighSweeps)), "CTX|STAT|ASIA|SWEEP_H_RATE", display=telemetryDisplay)
plot(onlyCurrent(sampleRate(asiaLowSweeps)), "CTX|STAT|ASIA|SWEEP_L_RATE", display=telemetryDisplay)
plot(onlyCurrent(sampleRate(londonAsiaHighSweeps)), "CTX|STAT|LONDON|SWEEP_ASIA_H_RATE", display=telemetryDisplay)
plot(onlyCurrent(sampleRate(londonAsiaLowSweeps)), "CTX|STAT|LONDON|SWEEP_ASIA_L_RATE", display=telemetryDisplay)
plot(onlyCurrent(sampleRate(nyLondonReversals)), "CTX|STAT|NY|REVERSE_LONDON_RATE", display=telemetryDisplay)

var table crossDashboard = table.new(position.bottom_right, 4, 9, border_width=1, border_color=color.new(color.gray, 70), bgcolor=color.new(color.black, 18))
if barstate.islast and showCrossDashboard
    table.cell(crossDashboard, 0, 0, "Market", text_color=color.white, bgcolor=color.new(color.teal, 55))
    table.cell(crossDashboard, 1, 0, "Price", text_color=color.white, bgcolor=color.new(color.teal, 55))
    table.cell(crossDashboard, 2, 0, "4H %", text_color=color.white, bgcolor=color.new(color.teal, 55))
    table.cell(crossDashboard, 3, 0, "1D %", text_color=color.white, bgcolor=color.new(color.teal, 55))
    table.cell(crossDashboard, 0, 1, "USDT.D", text_color=color.silver)
    table.cell(crossDashboard, 1, 1, usdtEnabled ? str.tostring(usdtClose, "#.###") : "off", text_color=color.white)
    table.cell(crossDashboard, 2, 1, usdtEnabled ? str.tostring(usdt4h, "#.##") : "-", text_color=usdt4h >= 0 ? color.green : color.red)
    table.cell(crossDashboard, 3, 1, usdtEnabled ? str.tostring(usdt1d, "#.##") : "-", text_color=usdt1d >= 0 ? color.green : color.red)
    table.cell(crossDashboard, 0, 2, "BTC.D", text_color=color.silver)
    table.cell(crossDashboard, 1, 2, btcEnabled ? str.tostring(btcClose, "#.###") : "off", text_color=color.white)
    table.cell(crossDashboard, 2, 2, btcEnabled ? str.tostring(btc4h, "#.##") : "-", text_color=btc4h >= 0 ? color.green : color.red)
    table.cell(crossDashboard, 3, 2, btcEnabled ? str.tostring(btc1d, "#.##") : "-", text_color=btc1d >= 0 ? color.green : color.red)
    table.cell(crossDashboard, 0, 3, "ETHBTC", text_color=color.silver)
    table.cell(crossDashboard, 1, 3, ethBtcEnabled ? str.tostring(ethBtcClose, "#.######") : "off", text_color=color.white)
    table.cell(crossDashboard, 2, 3, ethBtcEnabled ? str.tostring(ethBtc4h, "#.##") : "-", text_color=ethBtc4h >= 0 ? color.green : color.red)
    table.cell(crossDashboard, 3, 3, ethBtcEnabled ? str.tostring(ethBtc1d, "#.##") : "-", text_color=ethBtc1d >= 0 ? color.green : color.red)
    table.cell(crossDashboard, 0, 4, "DXY", text_color=color.silver)
    table.cell(crossDashboard, 1, 4, dxyEnabled ? str.tostring(dxyClose, "#.###") : "off", text_color=color.white)
    table.cell(crossDashboard, 2, 4, dxyEnabled ? str.tostring(dxy4h, "#.##") : "-", text_color=dxy4h >= 0 ? color.green : color.red)
    table.cell(crossDashboard, 3, 4, dxyEnabled ? str.tostring(dxy1d, "#.##") : "-", text_color=dxy1d >= 0 ? color.green : color.red)
    table.cell(crossDashboard, 0, 5, "NASDAQ", text_color=color.silver)
    table.cell(crossDashboard, 1, 5, nasdaqEnabled ? str.tostring(nasdaqClose, "#.##") : "off", text_color=color.white)
    table.cell(crossDashboard, 2, 5, nasdaqEnabled ? str.tostring(nasdaq4h, "#.##") : "-", text_color=nasdaq4h >= 0 ? color.green : color.red)
    table.cell(crossDashboard, 3, 5, nasdaqEnabled ? str.tostring(nasdaq1d, "#.##") : "-", text_color=nasdaq1d >= 0 ? color.green : color.red)
    table.cell(crossDashboard, 0, 6, "SPX", text_color=color.silver)
    table.cell(crossDashboard, 1, 6, spxEnabled ? str.tostring(spxClose, "#.##") : "off", text_color=color.white)
    table.cell(crossDashboard, 2, 6, spxEnabled ? str.tostring(spx4h, "#.##") : "-", text_color=spx4h >= 0 ? color.green : color.red)
    table.cell(crossDashboard, 3, 6, spxEnabled ? str.tostring(spx1d, "#.##") : "-", text_color=spx1d >= 0 ? color.green : color.red)
    table.cell(crossDashboard, 0, 7, "VIX", text_color=color.silver)
    table.cell(crossDashboard, 1, 7, vixEnabled ? str.tostring(vixClose, "#.##") : "off", text_color=color.white)
    table.cell(crossDashboard, 2, 7, vixEnabled ? str.tostring(vix4h, "#.##") : "-", text_color=vix4h >= 0 ? color.green : color.red)
    table.cell(crossDashboard, 3, 7, vixEnabled ? str.tostring(vix1d, "#.##") : "-", text_color=vix1d >= 0 ? color.green : color.red)
    table.cell(crossDashboard, 0, 8, "US10Y", text_color=color.silver)
    table.cell(crossDashboard, 1, 8, us10yEnabled ? str.tostring(us10yClose, "#.###") : "off", text_color=color.white)
    table.cell(crossDashboard, 2, 8, us10yEnabled ? str.tostring(us10y4h, "#.##") : "-", text_color=us10y4h >= 0 ? color.green : color.red)
    table.cell(crossDashboard, 3, 8, us10yEnabled ? str.tostring(us10y1d, "#.##") : "-", text_color=us10y1d >= 0 ? color.green : color.red)
