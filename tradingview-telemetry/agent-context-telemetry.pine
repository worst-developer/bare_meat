plot(onlyCurrent(atr), "CTX|VOLATILITY|ATR", display=telemetryDisplay)
plot(onlyCurrent(atrPct), "CTX|VOLATILITY|ATR_PCT", display=telemetryDisplay)
plot(onlyCurrent(dayRangeAtr), "CTX|VOLATILITY|DAY_RANGE_ATR", display=telemetryDisplay)
plot(onlyCurrent(sessionRangeAtr), "CTX|VOLATILITY|SESSION_RANGE_ATR", display=telemetryDisplay)
plot(onlyCurrent(dailyOpen), "CTX|LEVEL|DO", display=telemetryDisplay)
plot(onlyCurrent(prevDailyHigh), "CTX|LEVEL|PDH", display=telemetryDisplay)
plot(onlyCurrent(prevDailyLow), "CTX|LEVEL|PDL", display=telemetryDisplay)
plot(onlyCurrent(prevDailyClose), "CTX|LEVEL|PDC", display=telemetryDisplay)
plot(onlyCurrent(prevDailyMid), "CTX|LEVEL|PDMID", display=telemetryDisplay)
plot(onlyCurrent(weeklyOpen), "CTX|LEVEL|WO", display=telemetryDisplay)
plot(onlyCurrent(prevWeeklyHigh), "CTX|LEVEL|PWH", display=telemetryDisplay)
plot(onlyCurrent(prevWeeklyLow), "CTX|LEVEL|PWL", display=telemetryDisplay)
plot(onlyCurrent(prevWeeklyClose), "CTX|LEVEL|PWC", display=telemetryDisplay)
plot(onlyCurrent(monthlyOpen), "CTX|LEVEL|MO", display=telemetryDisplay)
plot(onlyCurrent(prevMonthlyHigh), "CTX|LEVEL|PMH", display=telemetryDisplay)
plot(onlyCurrent(prevMonthlyLow), "CTX|LEVEL|PML", display=telemetryDisplay)
plot(onlyCurrent(prevMonthlyClose), "CTX|LEVEL|PMC", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(totalEnabled, totalClose)), "CTX|CROSS|TOTAL|PRICE", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(totalEnabled, total1h)), "CTX|CROSS|TOTAL|RET_1H", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(totalEnabled, total4h)), "CTX|CROSS|TOTAL|RET_4H", display=telemetryDisplay)
plot(onlyCurrent(enabledValue(totalEnabled, total1d)), "CTX|CROSS|TOTAL|RET_1D", display=telemetryDisplay)
